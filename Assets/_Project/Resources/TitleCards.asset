  _fallbackTagline: Somebody has to do it.
  _entries:
  - BossId: gatekeeper
    Tagline: No key, no entry, no excuses.
    VictoryTagline: The gate swings open.
  - BossId: brood_mother
    Tagline: Mind the webs, and mind the children.
    VictoryTagline: The nursery falls silent.
  - BossId: bell_twins
    Tagline: Two chimes, one nasty ring.
    VictoryTagline: The last echo fades.
  - BossId: test_boss
    Tagline: A very patient tutorial.
    VictoryTagline: Lesson learned.
  - BossId: final_test_boss
    Tagline: The big finish, rehearsed.
    VictoryTagline: A flawless rehearsal.
  _victoryTitle: THAT'S A WRAP
  _fallbackVictoryTagline: Scene cleared. Take a bow.
  _finalVictoryTitle: CURTAIN CALL
  _finalVictoryTagline: Every floor cleared. The house is on its feet.
  _defeatTitle: TAKE TWO
  _defeatTagline: The reel runs out. Roll it back and go again.
